{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordanallm.example/tribunus/config.schema.json",
  "title": "Tribunus configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "graph": {
      "type": "object",
      "default": {
        "max_depth": 12
      },
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "budgets": {
      "type": "object",
      "default": {
        "default": {
          "tokens": 200000,
          "wall_clock_seconds": 3600
        }
      },
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "object",
          "default": {
            "tokens": 200000,
            "wall_clock_seconds": 3600
          },
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "integer",
              "default": 200000,
              "minimum": 0,
              "maximum": 10000000
            },
            "wall_clock_seconds": {
              "type": "integer",
              "default": 3600,
              "minimum": 0,
              "maximum": 86400
            }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "default": [],
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "log_path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "default": "",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "command": {
            "type": "array",
            "default": [],
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "log_path": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 4096
          },
          "schedule": {
            "type": "string",
            "default": "always",
            "minLength": 0,
            "maxLength": 120
          },
          "router_alias": {
            "type": "string",
            "default": "cordana/auto",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          },
          "restart": {
            "type": "object",
            "default": {
              "policy": "never",
              "max_restarts": 0,
              "backoff_seconds": 0
            },
            "additionalProperties": false,
            "properties": {
              "policy": {
                "type": "string",
                "default": "never",
                "enum": [
                  "never",
                  "on-failure",
                  "always"
                ]
              },
              "max_restarts": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 32
              },
              "backoff_seconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 3600
              }
            }
          },
          "stop": {
            "type": "object",
            "default": {
              "signal": "TERM",
              "grace_seconds": 0
            },
            "additionalProperties": false,
            "properties": {
              "signal": {
                "type": "string",
                "default": "TERM",
                "enum": [
                  "TERM",
                  "INT",
                  "HUP"
                ]
              },
              "grace_seconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 300
              }
            }
          },
          "sandbox": {
            "type": "object",
            "default": {
              "mode": "enforce",
              "reason": "",
              "workspace": "",
              "inputs": [],
              "env_allow": [],
              "network": "none",
              "memory_max": "2G",
              "cpu_weight": 100,
              "tasks_max": 512
            },
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "default": "enforce",
                "enum": [
                  "enforce",
                  "off"
                ]
              },
              "reason": {
                "type": "string",
                "default": "",
                "maxLength": 512
              },
              "workspace": {
                "type": "string",
                "default": "",
                "maxLength": 4096
              },
              "inputs": {
                "type": "array",
                "default": [],
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "env_allow": {
                "type": "array",
                "default": [],
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z_][A-Z0-9_]*$"
                }
              },
              "network": {
                "type": "string",
                "default": "none",
                "enum": [
                  "none",
                  "egress"
                ]
              },
              "memory_max": {
                "type": "string",
                "default": "2G",
                "pattern": "^[1-9][0-9]*[KMGT]?$"
              },
              "cpu_weight": {
                "type": "integer",
                "default": 100,
                "minimum": 1,
                "maximum": 10000
              },
              "tasks_max": {
                "type": "integer",
                "default": 512,
                "minimum": 16,
                "maximum": 32768
              }
            }
          }
        }
      }
    },
    "watches": {
      "type": "array",
      "default": [],
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "trigger",
          "router_alias"
        ],
        "properties": {
          "name": {
            "type": "string",
            "default": "",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "trigger": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 120
          },
          "router_alias": {
            "type": "string",
            "default": "cordana/auto",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "router": {
      "type": "object",
      "default": {
        "aliases": [
          "cordana/auto"
        ]
      },
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "array",
          "default": [
            "cordana/auto"
          ],
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "default": {
        "probe": {
          "timeout_seconds": 30,
          "interval_seconds": 5,
          "ready_threshold": 2
        }
      },
      "additionalProperties": false,
      "properties": {
        "probe": {
          "type": "object",
          "default": {
            "timeout_seconds": 30,
            "interval_seconds": 5,
            "ready_threshold": 2
          },
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 300
            },
            "interval_seconds": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 60
            },
            "ready_threshold": {
              "type": "integer",
              "default": 2,
              "minimum": 1,
              "maximum": 10
            }
          }
        }
      }
    },
    "event_log": {
      "type": "object",
      "default": {
        "dir": ".tribunus",
        "signing_key_path": "",
        "public_key": "",
        "lock_timeout_seconds": 5,
        "max_replay_records": 100000
      },
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "default": ".tribunus",
          "minLength": 1,
          "maxLength": 4096
        },
        "signing_key_path": {
          "type": "string",
          "default": "",
          "maxLength": 4096
        },
        "public_key": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[0-9a-fA-F]{64}$"
        },
        "lock_timeout_seconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 300
        },
        "max_replay_records": {
          "type": "integer",
          "default": 100000,
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "release_watch": {
      "type": "object",
      "default": {
        "state_dir": "",
        "rate_limit_floor": 100,
        "max_actions_per_run": 12,
        "per_source_cap": 3,
        "routes": []
      },
      "additionalProperties": false,
      "properties": {
        "state_dir": {
          "type": "string",
          "default": "",
          "maxLength": 4096
        },
        "rate_limit_floor": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "maximum": 100000
        },
        "max_actions_per_run": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 100
        },
        "per_source_cap": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 20
        },
        "routes": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sources",
              "sinks"
            ],
            "properties": {
              "name": {
                "type": "string",
                "default": "",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "sources": {
                "type": "array",
                "default": [],
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "github": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                    },
                    "huggingface_org": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+$"
                    }
                  }
                }
              },
              "sinks": {
                "type": "array",
                "default": [],
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "github_issue": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "repo"
                      ],
                      "properties": {
                        "repo": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                        },
                        "labels": {
                          "type": "array",
                          "default": [],
                          "maxItems": 8,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          }
                        }
                      }
                    },
                    "ntfy": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "topic"
                      ],
                      "properties": {
                        "topic": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]+$"
                        },
                        "priority": {
                          "type": "integer",
                          "default": 3,
                          "minimum": 1,
                          "maximum": 5
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

