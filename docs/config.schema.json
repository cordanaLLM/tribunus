{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordanallm.example/tribunus/config.schema.json",
  "title": "Tribunus configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "graph": {
      "type": "object",
      "default": {
        "max_depth": 12
      },
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "budgets": {
      "type": "object",
      "default": {
        "default": {
          "tokens": 200000,
          "wall_clock_seconds": 3600
        }
      },
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "object",
          "default": {
            "tokens": 200000,
            "wall_clock_seconds": 3600
          },
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "integer",
              "default": 200000,
              "minimum": 0,
              "maximum": 10000000
            },
            "wall_clock_seconds": {
              "type": "integer",
              "default": 3600,
              "minimum": 0,
              "maximum": 86400
            }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "default": [],
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "log_path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "default": "",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "command": {
            "type": "array",
            "default": [],
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "log_path": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 4096
          },
          "schedule": {
            "type": "string",
            "default": "always",
            "minLength": 0,
            "maxLength": 120
          },
          "router_alias": {
            "type": "string",
            "default": "cordana/auto",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          },
          "restart": {
            "type": "object",
            "default": {
              "policy": "never",
              "max_restarts": 0,
              "backoff_seconds": 0
            },
            "additionalProperties": false,
            "properties": {
              "policy": {
                "type": "string",
                "default": "never",
                "enum": [
                  "never",
                  "on-failure",
                  "always"
                ]
              },
              "max_restarts": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 32
              },
              "backoff_seconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 3600
              }
            }
          },
          "stop": {
            "type": "object",
            "default": {
              "signal": "TERM",
              "grace_seconds": 0
            },
            "additionalProperties": false,
            "properties": {
              "signal": {
                "type": "string",
                "default": "TERM",
                "enum": [
                  "TERM",
                  "INT",
                  "HUP"
                ]
              },
              "grace_seconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 300
              }
            }
          }
        }
      }
    },
    "watches": {
      "type": "array",
      "default": [],
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "trigger",
          "router_alias"
        ],
        "properties": {
          "name": {
            "type": "string",
            "default": "",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "trigger": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 120
          },
          "router_alias": {
            "type": "string",
            "default": "cordana/auto",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "router": {
      "type": "object",
      "default": {
        "aliases": [
          "cordana/auto"
        ]
      },
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "array",
          "default": [
            "cordana/auto"
          ],
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "default": {
        "probe": {
          "timeout_seconds": 30,
          "interval_seconds": 5,
          "ready_threshold": 2
        }
      },
      "additionalProperties": false,
      "properties": {
        "probe": {
          "type": "object",
          "default": {
            "timeout_seconds": 30,
            "interval_seconds": 5,
            "ready_threshold": 2
          },
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 300
            },
            "interval_seconds": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 60
            },
            "ready_threshold": {
              "type": "integer",
              "default": 2,
              "minimum": 1,
              "maximum": 10
            }
          }
        }
      }
    },
    "event_log": {
      "type": "object",
      "default": {
        "dir": ".tribunus",
        "signing_key_path": "",
        "public_key": "",
        "lock_timeout_seconds": 5,
        "max_replay_records": 100000
      },
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "default": ".tribunus",
          "minLength": 1,
          "maxLength": 4096
        },
        "signing_key_path": {
          "type": "string",
          "default": "",
          "maxLength": 4096
        },
        "public_key": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[0-9a-fA-F]{64}$"
        },
        "lock_timeout_seconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 300
        },
        "max_replay_records": {
          "type": "integer",
          "default": 100000,
          "minimum": 1,
          "maximum": 1000000
        }
      }
    }
  }
}
